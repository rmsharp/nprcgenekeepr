^renv$
^renv\.lock$
^CRAN-RELEASE$
^_pkgdown\.yml$
^.*\.Rproj$
^\.Rproj\.user$
^\.travis\.yml$
^\.httr-oauth$
^\.Rprofile$
^cran-comments\.md$
# All dated CRAN-submission comment files YYYYMMDD_cran-comments.md -- one regex
# covers every dated file incl. future ones, so a new one never silently ships.
^[0-9]+_cran-comments\.md$
^codecov\.yml$
^docs$
^\.gitignore$
^tests/testthat/test_basic\.R$
^R/testingScript\.R$
^R/depricated_gene\.drop\.R$
^vignettes/.*\.log$
^vignettes/.*\.aux$
^vignettes/.*\.out$
^\.Rhistory$
^\.Rhistory\ 2$
^vignettes/shiny_app_use_original$
^vignettes/shiny_app_use_original/.*\.png$
^vignettes/interactive\.Rmd$
^vignettes/shiny_app_use\.Rmd$
^vignettes/_ColonyManagerTutorial\.Rmd$
^vignettes/Development_Plans.Rmd$
README\.*\.png$
# An Rmarkdown file used to generate README.md
^README\.Rmd$
# Comments for CRAN submission
# A news file written in RMarkdown
^NEWS\.Rmd$
^NOTES\ todo\.txt$
# Used for continuous integration testing with travis
^\.github$
^CODE_OF_CONDUCT\.md$
^rsconnect*$
^rsconnect/*$
^images$
^images/*$
^LICENSE\.md$
^\.lintr$
^pkgdown$
^pkgdown_site$
# Quarto pkgdown articles (website-only; never shipped). One pattern covers the
# .qmd articles, vignettes/articles/_quarto.yml, and any .quarto/ build cache.
^vignettes/articles$
^data-raw$
^dev$
^doc$
^Meta$
^revdep$
^tests/testthat/_snaps$
^CITATION\.cff$
^CRAN-SUBMISSION$
^test_results_summary.md
^\.\.Rcheck$
^\.positai$
^\.claude$
# Methodology framework files (tooling, not R package content).
# NOTE: every line in this file is a perl regex -- a comment with an unbalanced
# paren makes R CMD build abort. Keep the <NAME>.*\.md$ form broad so macOS sync
# dupes like SESSION_NOTES 2.md and CLAUDE copy.md stay build-ignored and never
# re-raise R CMD check's non-portable-file-names WARNING. S59 generalized S58.
^PROJECT_LEARNINGS.*\.md$
^CLAUDE.*\.md$
^SESSION_RUNNER.*\.md$
^SESSION_NOTES.*\.md$
^SAFEGUARDS.*\.md$
^BACKLOG.*\.md$
^ROADMAP.*\.md$
^CHANGELOG.*\.md$
^BOOTSTRAP.*\.md$
^CONTEXT_TEMPLATE.*\.md$
^HANDOFFS.*\.md$
^dashboard_history\.jsonl$

# Methodology tooling, audit reports, and dev notes -- not R package content,
# so they are build-ignored. Broad <NAME>.* forms also catch macOS sync dupes.
^methodology_dashboard\.py$
^dashboard\.html$
^nprcgenekeepr_notes\.txt$
^RECOMMENDED_SKILLS.*\.md$
^PED_GV_AUDIT.*
^TECH_DEBT_AUDIT.*

# Build cruft (S102, CRAN submission Phase 1). Every line here is a perl regex --
# an unbalanced paren even in a comment aborts R CMD build, so keep lines paren-free.
# The .DS_Store / .Rapp.history lines are end-anchored only (no leading ^) so they
# also catch copies in subdirs, e.g. man/.DS_Store and inst/extdata/.Rapp.history.
\.DS_Store$
\.Rapp\.history$
^inst/_pkgdown\.yml$

# User's local-only copyrighted reference material -- full-text journal articles/pages under
# publisher copyright, no open-access marking. Mirrors .gitignore's own S479 exclusion of
# these same 3 files, kept off the PUBLIC git repo deliberately, extended here because
# .gitignore has no effect on R CMD build's tarball contents: R CMD build reads the actual
# filesystem, not git's index, so these files were still being bundled into every built/
# distributed package tarball despite being deliberately kept out of the repo. Found S497,
# 2026-08-09, prompted by the owner renaming the third file for its own non-portable-filename
# fix -- see CHANGELOG.md. Does NOT cover
# inst/extdata/reference/Master_Genetic_metrics_2_14_15.pdf, an unpublished NPRC working-group
# document already committed and shipped S418 -- a different copyright situation.
^inst/extdata/reference/pedigree_nomenclature\.html$
^inst/extdata/reference/5201430\.pdf$
^inst/extdata/reference/bioinformatics_24_2_279\.pdf$

# kinship2's own supplementary material -- an NIHMS/PMC deposit, free reading access via NIH's
# public-access policy, not confirmed to carry third-party redistribution rights. Mirrors
# .gitignore's own S567 exclusion; extended here for the same reason S497 extended the 3 files
# above -- .gitignore has no effect on R CMD build's tarball contents. Session 567, 2026-08-14,
# owner decision via AskUserQuestion, see CHANGELOG.md.
^inst/extdata/reference/NIHMS593658-supplement-supplement_1\.pdf$
^FRAMEWORK_LEARNINGS\.md$
^methodology_trim\.py$
^__pycache__$
